[node name="Texte" type="RichTextLabel" parent="UpperLayer/Fenetre_lancer/Disposition/VBoxContainer" unique_id=1022750740]
layout_mode = 2
text = "Le feu de ta lanterne n’est pas qu’une lumière : lance-le, et il embrase tout sur son passage. Portes, pièges, obstacles… les flammes ouvriront ta route.
Mais gare : une flamme perdue l’est pour toujours. Rejoins le brasier que tu as allumé et reprends ta lanterne avant qu’il ne s’éteigne… ou l’obscurité t’engloutira."
fit_content = true

